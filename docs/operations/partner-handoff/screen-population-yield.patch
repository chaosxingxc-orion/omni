+def population_forecast(cfg, progress):
+    """Estimate *both* domains, keeping preferential historical misses out of random strata."""
+    from recall_cpu_prepare import checked
+    cutoff = datetime.datetime.fromisoformat(progress['at']).timestamp()
+    root = Path(cfg['output'])
+    recall = json.loads((Path(cfg['recall'])/'RECALL-COMPLETE.json').read_bytes())
+    def lines(path):
+        with path.open() as f:
+            for line in f:
+                yield json.loads(line)
+    priority = {r['sample_id'] for r in lines(Path(cfg['history'])/'exploration-P-MISS.private.jsonl')
+                if r.get('valid', True) is True}
+    cells = collections.defaultdict(collections.Counter)
+    with sqlite3.connect((root/'p-screen.sqlite').as_uri()+'?mode=ro',uri=True) as db:
+        seen = dict(db.execute("select rid, rank=0 from calls where status='valid' and finished<=?",(cutoff,)))
+    for row in lines(checked(recall['p_gate_roster'])):
+        rid = row['reference_id']
+        domain = {'train_real':'real','train_synth':'synthetic'}[rid.split(':',1)[0]]
+        sid = 'slurp:train:'+row['source_id'].zfill(6)+':'+Path(row['recording']).stem
+        rank = row['rank']
+        cell = cells[domain,'priority' if sid in priority else 'random',
+                     '1' if rank==1 else '2-3' if rank<=3 else '4+']
+        cell['N'] += 1
+        if rid in seen:
+            cell['n'] += 1
+            cell['k'] += seen[rid]
+    if sum(v['n'] for v in cells.values()) != len(seen):
+        raise ValueError('screen observations outside gated TRAIN')
+    if sum(v['N'] for (_,p,_),v in cells.items() if p=='priority') != json.loads((root/'HISTORY.json').read_bytes())['incorrect']:
+        raise ValueError('historical priority set differs from actual dispatch')
+    strata=[]; totals={}
+    for domain in sorted(progress['quotas']):
+        estimate=0
+        for (d,group,rank),s in sorted(cells.items()):
+            if d != domain:continue
+            N,n,k=s['N'],s['n'],s['k']
+            projection=k+(N-n)*k/n if n else None
+            strata.append(dict(domain=d,priority=group,rank=rank,population=N,observed=n,errors=k,projected=projection))
+            estimate=None if estimate is None or projection is None else estimate+projection
+        totals[domain]=estimate
+    q=progress['quotas']; target=sum(domain['error'] for domain in q.values())
+    projection=sum(totals.values()) if all(v is not None for v in totals.values()) else None
+    minimum={d:max(0,sum(q[d].values())-sum(v['success'] for v in q.values())) for d in q}
+    return dict(snapshot=progress['at'],cutoff='observations ending on or before snapshot second',valid=len(seen),
+        historical_use='earlier misses define dispatch priority only; only actual current P outcomes counted',
+        scope='empirical projection; not an exhaustion proof, admission decision, or dispatch input',
+        strata=strata,projected_total_by_domain=totals,projected_total=projection,
+        exact_crossed_error_quota={d:q[d]['error'] for d in q},
+        minimum_errors_by_domain_if_only_margins_fixed=minimum,
+        minimum_total_errors_even_if_domain_mix_removed=target)
 
 
