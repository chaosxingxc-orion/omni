+"""Start the existing iteration controller in its cross-host source namespace."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import sys
+
+
+def launch(manifest, config):
+    local = json.loads(manifest.read_bytes())
+    release = Path(local['release'])
+    bind = local['iteration_entry']
+    root = Path(bind['logical_root'])
+    relative = Path(bind['source'])
+    if not root.is_absolute() or not relative.parts or relative.is_absolute() or '..' in relative.parts:
+        raise ValueError('invalid iteration source binding')
+    entry = root/relative
+    if (not entry.samefile(release/'tree/parents'/relative)
+            or not os.statvfs(entry).f_flag & os.ST_RDONLY
+            or hashlib.sha256(entry.read_bytes()).hexdigest() != bind['sha256']):
+        raise ValueError('iteration entry differs from its read-only selected release')
+    os.execv(sys.executable, [sys.executable, '-B', str(entry), '--config', str(config)])
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--manifest', type=Path, required=True)
+    parser.add_argument('--config', type=Path, required=True)
+    args = parser.parse_args()
+    launch(args.manifest, args.config)
