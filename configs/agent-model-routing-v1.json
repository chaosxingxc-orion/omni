{
  "schema": "omni.agent_model_routing.v1",
  "updated_at": "2026-11-05T02:49:14.392754+00:00",
  "language": "zh-CN",
  "dispatch_policy": {
    "require_file_delivery": true,
    "message_is_not_delivery": true,
    "unavailable_model_is_blocking": true,
    "inflight_model_change": "keep_existing_owner_until_terminal_or_explicit_handoff",
    "probe_scheduling": "use_next_available_slot; never exceed max_active_processes",
    "execution_backend": "codex_subprocess",
    "collaboration_subagents_enabled": false,
    "max_active_processes": 3,
    "task_transport": "stdin_from_task_file",
    "delivery_transport": "filesystem",
    "nested_delegation_allowed": false
  },
  "roles": {
    "engineering_development": {
      "model": "gpt-6.1-terra",
      "scope": [
        "工程开发",
        "固定脚本与配置",
        "测试实现",
        "文档生成"
      ],
      "delivery": "REPORT.md + result.json + changed_files_sha256 + test evidence",
      "routing_state": "preferred_tool_execution_observed",
      "original_model": "gpt-6.1-terra",
      "switch_reason": "Owner restored Terra; a dispatch requesting gpt-6.1-terra has executed tools and written its task receipt; full business delivery is pending"
    },
    "sample_analysis": {
      "model": "gpt-6.1-sol",
      "scope": [
        "样本分析",
        "统计结果",
        "bad case根因分析"
      ],
      "delivery": "REPORT.md + source evidence + reproducible analysis output"
    },
    "planning_evaluation_replanning": {
      "model": "gpt-6-astra",
      "scope": [
        "任务规划",
        "结果评价",
        "重新规划"
      ],
      "delivery": "evaluation report with evidence boundaries and next decision"
    }
  },
  "availability": {
    "gpt-6.1-terra": {
      "status": "requested_model_tool_execution_observed",
      "probe_required": false,
      "do_not_claim_execution_before_probe": true,
      "provider_model_identity": "not_independently_verified",
      "business_delivery": "in_progress"
    },
    "gpt-6.1-sol": {
      "status": "verified_reachable"
    },
    "gpt-6-astra": {
      "status": "configured"
    }
  },
  "fallback_policy": {
    "engineering_development": "gpt-6.1-sol_if_terra_connection_fails_and_sol_execution_is_verified",
    "sample_analysis": "use_configured_sol_only",
    "planning_evaluation_replanning": "use_configured_astra_only",
    "never_silent_substitute": true
  }
}
