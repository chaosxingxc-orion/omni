  "value_rules_by_kind": {
    "enumerated_observed": [
      "Use observed variants to recognize the spoken value, not to insert a frequent value.",
      "An unlisted spoken value remains possible; this inventory is not a closed business ontology."
    ],
    "open": [
      "Fill the expression identifying the entity in the original query.",
      "Do not substitute a better-known name or copy a demonstration name."
    ],
    "pattern": [
      "Examples illustrate expression forms; they do not enumerate possible values.",
      "Preserve the expressed quantity, unit, recurrence or temporal qualifier; do not infer a missing reference date."
    ]
  },
  "value_rules_by_type": {
    "date": [
      "Retain relative and calendar expressions as expressed; do not calculate a calendar date without a reference."
    ],
    "time": [
      "Retain the spoken time or duration, including stated units and qualifiers."
    ],
    "change_amount": [
      "Retain the stated quantity and unit; do not convert a relative change into an absolute result."
    ],
    "general_frequency": [
      "Retain the expressed recurrence, including interval and qualifier where spoken."
    ],
    "email_address": [
      "Retain the spoken address; conversion of spoken at/dot into symbols requires an explicit output normalization policy."
    ]
  }
