  "boundary": "A pre-computed model-free input, never an authorization: it opens no attempt, reserves no contact, admits no mechanism, releases or rebuilds no store and states no effectiveness claim. The released store, its facet ids and its delivered bodies are unchanged; only a retrieval key file exists beside them, to be pinned by one derived baseline. No gold label, reference transcript or future turn enters it.",
  "builder_id": "saea-slurp-intent-boundary-centroid-keys-builder-v1",
  "builder_sha256": "161a345e1b25a5d0973320a159b2101b34fdc5ca9a55c39e337afcfca9a976aa",
  "construction": {
    "arithmetic_source": {
      "functions_used": [
        "load_boundary",
        "load_pool_vectors",
        "unit_rows"
      ],
      "note": "imported byte-unchanged; the mean is bitwise the diagnostic's 'centroid' construction",
      "relpath": "scripts/analysis/slurp_boundary_key_construction_diagnostic.py",
      "sha256": "f126fd4ac68daa832c8d26bddca39e2791d6aa1d2db32a55567859ad77808137"
    },
    "construction_pool": "the R01-excluded pool, so one file is held out on TRAIN Fold A, ROLL-1 (R01C) and DEV-2000-ADDED alike",
    "label_is": "the pool value's frozen build-time task_target, a released-store property; no gold label enters",
    "label_key": "task_target",
    "member_order": "pool facet ids ascending (the diagnostic's order)",
    "rule": "for each released intent, take every construction-pool facet whose frozen build-time task_target names that intent, in pool facet-id order; unit-normalise each member vector in float64 (rails.kb_policy._cosine_with_norms' own quotient); take the arithmetic mean over the members; unit-normalise the mean. An intent with no member in this pool keeps the flown written key vector, byte for byte."
  },
