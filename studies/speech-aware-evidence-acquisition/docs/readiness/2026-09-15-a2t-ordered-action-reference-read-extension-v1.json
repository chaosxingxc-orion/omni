  "frozen_definitions": {
    "decomposition": "For observed states, expected count minus union, union minus unordered, unordered minus ordered, ordered minus positional. For unavailable states keep expected occurrences in a separate unavailable category. All are descriptive compatibility losses, not causal error classes.",
    "full_quality": "Reuse persisted standard scores. Never reinterpret candidate compatibility as output correctness or parameter correctness.",
    "no_reference_actions": "Retain rows with zero expected occurrences; report them separately with full-coverage flags unavailable, not automatically correct.",
    "ordered": "Maximum order-preserving one-to-one matching between expected occurrences and candidate actions using exact tool-name membership.",
    "positional": "Count compatible equal-index pairs. Strict one-for-one sample coverage additionally requires equal action counts.",
    "state_unavailable": "Keep one finite unavailable state and its denominator; do not credit another state or drop the row.",
    "union": "Count each expected occurrence whose exact tool name is anywhere in the candidate union; this deliberately ignores assignment and order.",
    "unordered": "Maximum one-to-one matching from expected action occurrences to distinct candidate actions using exact tool-name membership."
  },
