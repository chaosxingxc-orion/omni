+std::string sha256_hex(const uint8_t * data, size_t size) {
+    unsigned char digest[SHA256_DIGEST_SIZE];
+    sha256_hash(digest, data, size);
+    static constexpr char hex[] = "0123456789abcdef";
+    std::string result(SHA256_DIGEST_SIZE * 2, '0');
+    for (size_t i = 0; i < SHA256_DIGEST_SIZE; ++i) {
+        result[i * 2]     = hex[digest[i] >> 4];
+        result[i * 2 + 1] = hex[digest[i] & 0x0f];
+    }
+    return result;
+}
+
+std::string sha256_hex(const std::vector<uint8_t> & data) {
+    return sha256_hex(data.data(), data.size());
+}
+
+bool is_lower_sha256(const std::string & value) {
+    return value.size() == SHA256_DIGEST_SIZE * 2 &&
+        std::all_of(value.begin(), value.end(), [](unsigned char ch) {
+            return (ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f');
+        });
+}
+
+void require_lower_sha256(const json & document, const char * field) {
+    if (!document.contains(field) || !document.at(field).is_string() ||
+            !is_lower_sha256(document.at(field).get<std::string>())) {
+        throw std::invalid_argument(std::string(field) + " must be a lowercase 64-hex SHA-256");
+    }
+}
+
+void require_exact_keys(const json & document, const std::set<std::string> & expected, const char * subject) {
+    if (!document.is_object()) {
+        throw std::invalid_argument(std::string(subject) + " must be an object");
+    }
+    std::set<std::string> actual;
+    for (const auto & item : document.items()) {
+        actual.insert(item.key());
+    }
+    if (actual != expected) {
+        throw std::invalid_argument(std::string(subject) + " has unexpected or missing keys");
+    }
+}
+
+int32_t require_positive_i32(const json & document, const char * field) {
+    if (!document.contains(field) || !document.at(field).is_number_integer()) {
+        throw std::invalid_argument(std::string(field) + " must be a positive integer");
+    }
+    const int64_t value = document.at(field).get<int64_t>();
+    if (value <= 0 || value > std::numeric_limits<int32_t>::max()) {
+        throw std::invalid_argument(std::string(field) + " must fit a positive int32");
+    }
+    return static_cast<int32_t>(value);
+}
+
+std::string require_normalized_relative_path(const json & value, const char * subject) {
+    if (!value.is_string() || value.get_ref<const std::string &>().empty()) {
+        throw std::invalid_argument(std::string(subject) + " must be a non-empty string");
+    }
+    const std::string path_string = value.get<std::string>();
+    if (path_string.find('\\') != std::string::npos || path_string.find(':') != std::string::npos) {
+        throw std::invalid_argument(std::string(subject) + " must use a confined POSIX-style relative path");
+    }
+    const fs::path path(path_string);
+    if (path.is_absolute() || path.has_root_name() || path.has_root_directory() ||
+            path.lexically_normal().generic_string() != path_string) {
+        throw std::invalid_argument(std::string(subject) + " must be a normalized relative path");
+    }
+    for (const auto & component : path) {
+        if (component.empty() || component == "." || component == "..") {
+            throw std::invalid_argument(std::string(subject) + " contains a forbidden path component");
+        }
+    }
+    return path_string;
+}
+
+bool path_has_prefix(const fs::path & root, const fs::path & candidate) {
+    auto root_it = root.begin();
+    auto candidate_it = candidate.begin();
+    while (root_it != root.end() && candidate_it != candidate.end() && *root_it == *candidate_it) {
+        ++root_it;
+        ++candidate_it;
+    }
+    return root_it == root.end();
+}
+
+fs::path resolve_existing_confined(const fs::path & root, const std::string & relative, const char * subject) {
+    std::error_code ec;
+    const fs::path resolved = fs::canonical(root / relative, ec);
+    if (ec || !path_has_prefix(root, resolved)) {
+        throw std::invalid_argument(std::string(subject) + " does not resolve inside LLAMA_SPEECH_FEATURE_ROOT");
+    }
+    return resolved;
+}
+
+std::vector<uint8_t> read_binary_file(const fs::path & path, const char * subject) {
+    std::ifstream stream(path, std::ios::binary | std::ios::ate);
+    if (!stream) {
+        throw std::invalid_argument(std::string("cannot open ") + subject);
+    }
+    const std::streamsize size = stream.tellg();
+    if (size < 0) {
+        throw std::invalid_argument(std::string("cannot size ") + subject);
+    }
+    std::vector<uint8_t> bytes(static_cast<size_t>(size));
+    stream.seekg(0, std::ios::beg);
+    if (size > 0 && !stream.read(reinterpret_cast<char *>(bytes.data()), size)) {
+        throw std::invalid_argument(std::string("cannot read ") + subject);
+    }
+    return bytes;
+}
