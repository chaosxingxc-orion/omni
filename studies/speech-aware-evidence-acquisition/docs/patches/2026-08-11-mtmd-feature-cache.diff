+std::vector<server_speech_feature_chunk_ptr> load_speech_feature_packet(
+        const fs::path & root,
+        const json & descriptor,
+        int32_t expected_n_embd,
+        const std::string & expected_decoder_sha256) {
+    static const std::set<std::string> descriptor_keys = {"packet_id", "sha256", "role"};
+    static const std::set<std::string> packet_keys = {
+        "schema", "packet_id", "audio_sha256", "encoder_receipt_sha256",
+        "decoder_gguf_sha256", "mmproj_sha256", "position_mode",
+        "causal_attention", "chunks", "packet_sha256"
+    };
+    static const std::set<std::string> chunk_keys = {
+        "ordinal", "n_tokens", "n_pos", "n_embd", "dtype",
+        "feature_relpath", "feature_sha256", "position_relpath", "position_sha256"
+    };
+
+    require_exact_keys(descriptor, descriptor_keys, "speech feature descriptor");
+    const std::string packet_id = require_normalized_relative_path(descriptor.at("packet_id"), "packet_id");
+    require_lower_sha256(descriptor, "sha256");
+    if (!descriptor.at("role").is_string() ||
+            (descriptor.at("role") != "query" && descriptor.at("role") != "key")) {
+        throw std::invalid_argument("speech feature role must be query or key");
+    }
+
+    const fs::path packet_dir = resolve_existing_confined(root, packet_id, "speech feature packet");
+    if (!fs::is_directory(packet_dir)) {
+        throw std::invalid_argument("speech feature packet must resolve to a directory");
+    }
+    const fs::path manifest_path = resolve_existing_confined(packet_dir, "packet.json", "speech feature manifest");
+    const auto manifest_bytes = read_binary_file(manifest_path, "speech feature manifest");
+    json document;
+    try {
+        document = json::parse(manifest_bytes.begin(), manifest_bytes.end());
+    } catch (const std::exception & error) {
+        throw std::invalid_argument(std::string("invalid speech feature manifest JSON: ") + error.what());
+    }
+    require_exact_keys(document, packet_keys, "speech feature packet manifest");
+    if (!document.at("schema").is_string() || document.at("schema") != "saea-speech-feature-packet-v1") {
+        throw std::invalid_argument("unsupported speech feature packet schema");
+    }
+    if (!document.at("packet_id").is_string() || document.at("packet_id") != packet_id) {
+        throw std::invalid_argument("speech feature manifest packet_id disagrees with request");
+    }
+    for (const char * field : {
+            "audio_sha256", "encoder_receipt_sha256", "decoder_gguf_sha256",
+            "mmproj_sha256", "packet_sha256"}) {
+        require_lower_sha256(document, field);
+    }
+    if (document.at("decoder_gguf_sha256") != expected_decoder_sha256) {
+        throw std::invalid_argument("speech feature packet is bound to a different decoder GGUF");
+    }
+    if (document.at("packet_sha256") != descriptor.at("sha256")) {
+        throw std::invalid_argument("speech feature packet hash disagrees with request");
+    }
+    if (!document.at("position_mode").is_string() || document.at("position_mode") != "mrope_1d") {
+        throw std::invalid_argument("speech feature position_mode must be mrope_1d");
+    }
+    if (!document.at("causal_attention").is_boolean()) {
+        throw std::invalid_argument("speech feature causal_attention must be boolean");
+    }
+    if (!document.at("chunks").is_array() || document.at("chunks").empty()) {
+        throw std::invalid_argument("speech feature packet must contain chunks");
+    }
+
+    nlohmann::json canonical = nlohmann::json::parse(document.dump());
+    canonical.erase("packet_sha256");
+    const std::string canonical_bytes = canonical.dump();
+    const std::string calculated_packet_sha = sha256_hex(
+        reinterpret_cast<const uint8_t *>(canonical_bytes.data()), canonical_bytes.size());
+    if (calculated_packet_sha != document.at("packet_sha256").get<std::string>()) {
+        throw std::invalid_argument("speech feature packet canonical SHA-256 mismatch");
+    }
+
+    const bool causal_attention = document.at("causal_attention").get<bool>();
+    const std::string packet_sha = document.at("packet_sha256").get<std::string>();
+    std::vector<server_speech_feature_chunk_ptr> loaded;
+    loaded.reserve(document.at("chunks").size());
+    for (size_t ordinal = 0; ordinal < document.at("chunks").size(); ++ordinal) {
+        const json & chunk_json = document.at("chunks").at(ordinal);
+        require_exact_keys(chunk_json, chunk_keys, "speech feature chunk");
+        if (!chunk_json.at("ordinal").is_number_integer() ||
+                chunk_json.at("ordinal").get<int64_t>() != static_cast<int64_t>(ordinal)) {
+            throw std::invalid_argument("speech feature chunk ordinals must be contiguous from zero");
+        }
+        const int32_t n_tokens = require_positive_i32(chunk_json, "n_tokens");
+        const int32_t n_pos = require_positive_i32(chunk_json, "n_pos");
+        const int32_t n_embd = require_positive_i32(chunk_json, "n_embd");
+        if (n_pos != n_tokens) {
+            throw std::invalid_argument("SpeechFeaturePacketV1 currently requires n_pos == n_tokens");
+        }
+        if (n_embd != expected_n_embd) {
+            throw std::invalid_argument("speech feature n_embd does not match the decoder");
+        }
+        if (!chunk_json.at("dtype").is_string() || chunk_json.at("dtype") != "float32") {
+            throw std::invalid_argument("SpeechFeaturePacketV1 permits float32 only");
+        }
+        require_lower_sha256(chunk_json, "feature_sha256");
+        require_lower_sha256(chunk_json, "position_sha256");
+        const std::string feature_relpath = require_normalized_relative_path(
+            chunk_json.at("feature_relpath"), "feature_relpath");
+        const std::string position_relpath = require_normalized_relative_path(
+            chunk_json.at("position_relpath"), "position_relpath");
+        const auto feature_bytes = read_binary_file(
+            resolve_existing_confined(packet_dir, feature_relpath, "speech feature bytes"),
+            "speech feature bytes");
+        const auto position_bytes = read_binary_file(
+            resolve_existing_confined(packet_dir, position_relpath, "speech feature positions"),
+            "speech feature positions");
+        const size_t n_feature_values = static_cast<size_t>(n_tokens) * static_cast<size_t>(n_embd);
+        const size_t n_position_values = static_cast<size_t>(n_tokens) * 4;
+        if (feature_bytes.size() != n_feature_values * sizeof(float) ||
+                position_bytes.size() != n_position_values * sizeof(int32_t)) {
+            throw std::invalid_argument("speech feature chunk byte length disagrees with its dimensions");
+        }
+        if (sha256_hex(feature_bytes) != chunk_json.at("feature_sha256").get<std::string>() ||
+                sha256_hex(position_bytes) != chunk_json.at("position_sha256").get<std::string>()) {
+            throw std::invalid_argument("speech feature chunk SHA-256 mismatch");
+        }
+
+        auto chunk = std::make_shared<server_speech_feature_chunk>();
+        chunk->id = "saea-sf:" + packet_sha + ":" + std::to_string(ordinal);
+        chunk->n_tokens = n_tokens;
+        chunk->n_pos = n_pos;
+        chunk->n_embd = n_embd;
+        chunk->causal_attention = causal_attention;
+        chunk->embd.resize(n_feature_values);
+        std::memcpy(chunk->embd.data(), feature_bytes.data(), feature_bytes.size());
+        chunk->positions.resize(n_position_values);
+        static_assert(sizeof(llama_pos) == sizeof(int32_t), "SpeechFeaturePacketV1 positions require int32 llama_pos");
+        std::memcpy(chunk->positions.data(), position_bytes.data(), position_bytes.size());
+        loaded.push_back(std::move(chunk));
+    }
+    return loaded;
+}
+
+} // namespace
