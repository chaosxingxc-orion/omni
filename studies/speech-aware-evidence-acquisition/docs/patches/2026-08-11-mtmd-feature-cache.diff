+server_speech_feature_chunk_ptr server_speech_feature_find(const std::string & id) {
+    std::lock_guard<std::mutex> lock(g_speech_feature_mutex);
+    const auto found = g_speech_feature_chunks.find(id);
+    return found == g_speech_feature_chunks.end() ? nullptr : found->second;
+}
+
+server_tokens process_speech_feature_prompt(
+        const llama_vocab * vocab,
+        const std::string & prompt,
+        const json & descriptors,
+        int32_t expected_n_embd) {
+    if (!descriptors.is_array() || descriptors.empty()) {
+        throw std::invalid_argument("speech_feature_descriptors must be a non-empty array");
+    }
+    const char * root_env = std::getenv("LLAMA_SPEECH_FEATURE_ROOT");
+    if (root_env == nullptr || root_env[0] == '\0') {
+        throw std::invalid_argument("LLAMA_SPEECH_FEATURE_ROOT is required for speech feature requests");
+    }
+    std::error_code ec;
+    const fs::path root = fs::canonical(root_env, ec);
+    if (ec || !fs::is_directory(root)) {
+        throw std::invalid_argument("LLAMA_SPEECH_FEATURE_ROOT must name an existing directory");
+    }
+    const char * decoder_sha_env = std::getenv("LLAMA_SPEECH_DECODER_SHA256");
+    if (decoder_sha_env == nullptr || !is_lower_sha256(decoder_sha_env)) {
+        throw std::invalid_argument(
+            "LLAMA_SPEECH_DECODER_SHA256 must bind speech packets to the loaded decoder");
+    }
+
+    std::vector<std::vector<server_speech_feature_chunk_ptr>> packets;
+    packets.reserve(descriptors.size());
+    for (const auto & descriptor : descriptors) {
+        packets.push_back(load_speech_feature_packet(
+            root, descriptor, expected_n_embd, decoder_sha_env));
+    }
+    {
+        std::lock_guard<std::mutex> lock(g_speech_feature_mutex);
+        for (const auto & packet : packets) {
+            for (const auto & chunk : packet) {
+                g_speech_feature_chunks[chunk->id] = chunk;
+            }
+        }
+    }
+
+    server_tokens result(llama_tokens{}, true);
+    if (llama_vocab_get_add_bos(vocab)) {
+        result.push_back(llama_vocab_bos(vocab));
+    }
+    const std::string marker = get_media_marker();
+    size_t text_start = 0;
+    size_t descriptor_index = 0;
+    while (true) {
+        const size_t marker_pos = prompt.find(marker, text_start);
+        const size_t text_end = marker_pos == std::string::npos ? prompt.size() : marker_pos;
+        const auto text_tokens = common_tokenize(vocab, prompt.substr(text_start, text_end - text_start), false, true);
+        for (llama_token token : text_tokens) {
+            result.push_back(token);
+        }
+        if (marker_pos == std::string::npos) {
+            break;
+        }
+        if (descriptor_index >= packets.size()) {
+            throw std::invalid_argument("prompt contains more media markers than speech feature descriptors");
+        }
+        for (const auto & admitted : packets[descriptor_index++]) {
+            mtmd::input_chunk_ptr placeholder(mtmd_input_chunk_init_audio_placeholder(
+                admitted->n_tokens, admitted->n_pos, admitted->id.c_str()));
+            if (!placeholder) {
+                throw std::runtime_error("failed to construct speech feature placeholder");
+            }
+            result.push_back(placeholder.get());
+        }
+        text_start = marker_pos + marker.size();
+    }
+    if (descriptor_index != packets.size()) {
+        throw std::invalid_argument("prompt contains fewer media markers than speech feature descriptors");
+    }
+    if (llama_vocab_get_add_eos(vocab)) {
+        result.push_back(llama_vocab_eos(vocab));
+    }
+    return result;
+}
