          "SAEA-SLURP-STAGE3-NXT-R2-THINKING-BUDGET-FOLD-B-FIT-V1"
        ]
      }
    },
    "commit": {
      "paths": [
        "configs",
        "docs/exposure-ledger.md",
        "{readiness_dir}",
        "{readiness_dir}-preregistration.md"
      ],
      "message": "register: NX-T R2 (the per-node reasoning-budget column, TRAIN Fold B); rows countersigned; receipt minted"
    },
    "flip": {
      "script": "scripts/flights/nx/nxt_r2_flip.sh",
      "package": "docs/readiness/2026-10-15-slurp-nxt-r2-thinking-budget-fold-b-v1",
      "cells": [
        "slurp-native-stage3-nxt-r2-thinking-budget-fold-b-smoke-4-v1",
